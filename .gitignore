# Lesson videos are too big for GitHub (2+ GB, some files over 100 MB); keep them on the PC / a drive.
videos/**/*.mp4
videos/**/*.mov
# local tool output
tools/__pycache__/
templates/tools/__pycache__/
.claude/
.vscode/
node_modules/
.vite/
dist/
tmp/
# Keep the publisher's original large PDFs locally; generated reader pages are tracked.
books/**/*.pdf
# The book pages stay on this PC; the site gets them locked (pNNN.jpg.enc, made by tools/lock_books.py with the book
# password), so nobody can look at them on GitHub. After changing a page picture, run tools/lock_books.py again.
books/*/p[0-9][0-9][0-9].jpg
source-pdfs/

tools/book-key-worker/.wrangler/
tools/book-key-worker/node_modules/
